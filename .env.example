# Required
OPENROUTER_API_KEY=sk-or-...

# Optional: OpenBridge server binding
# OPENBRIDGE_HOST=0.0.0.0
# OPENBRIDGE_PORT=8000

# Optional: protect endpoints with a client API key
# OPENBRIDGE_CLIENT_API_KEY=...

# Optional: Redis-backed state/trace (requires `docker compose --profile redis ...`)
# OPENBRIDGE_STATE_BACKEND=redis
# OPENBRIDGE_TRACE_BACKEND=redis
# OPENBRIDGE_REDIS_URL=redis://redis:6379/0
# OPENBRIDGE_TRACE_REDIS_URL=redis://redis:6379/0
